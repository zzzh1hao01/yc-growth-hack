NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

# Google Places autocomplete (onboarding address field)
# Requires Maps JavaScript API + Places API (New) enabled in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_api_key_here

# Convex (from npx convex dev --once or dashboard)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# CONVEX_DEPLOY_KEY=dev:your-deployment-name|eyJ...  # CI/deploy only — do not commit

# Convex server-side env (set in dashboard, not in .env.local):
# OPENAI_API_KEY=
# EXA_API_KEY=           # Optional — deep web research fallback (not required)
# ORANGE_SLICE_API_KEY=
# ORANGE_SLICE_ENABLED=true
# ORANGE_SLICE_SHEET_WEBHOOK_URL=  # POST append endpoint (Zapier/Make or sponsor API)
# ORANGE_SLICE_SHEET_URL=           # Pipeline sheet link (shown in UI)
# OUTREACH_WEBHOOK_SECRET=          # Validates POST /orangeslice/status from sheet
# NEXT_PUBLIC_ORANGE_SLICE_SHEET_URL=https://www.orangeslice.ai/spreadsheets/YOUR_SHEET_ID/edit
# GOOGLE_MAPS_API_KEY=   # Geocoding + Places fallback
# FIBER_AI_API_KEY=      # Optional agency intel (Google Places used by default)

# Auth (optional — when set, app requires sign-in + org)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_JWT_ISSUER_DOMAIN=  # Convex dashboard → Clerk JWT template issuer

# App URL for Slack OAuth redirects
# NEXT_PUBLIC_APP_URL=https://householdiq-insurance.vercel.app

# Slack (optional — Settings → Connect Slack)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
